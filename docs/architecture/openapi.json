{
  "openapi": "3.1.0",
  "info": {
    "title": "Content Segmentation",
    "version": "2.0.0"
  },
  "paths": {
    "/api/v1/dataset": {
      "get": {
        "tags": [
          "Dataset"
        ],
        "summary": "Dataset",
        "operationId": "dataset_api_v1_dataset_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DatasetInfo"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/tasks/4/results": {
      "get": {
        "tags": [
          "Segmentation"
        ],
        "summary": "Results",
        "operationId": "results_api_v1_tasks_4_results_get",
